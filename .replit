modules = ["php-8.2", "web", "nodejs-20"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PHP Web Server"

[[workflows.workflow]]
name = "PHP Web Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "php -S 0.0.0.0:5000 router.php"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33883
externalPort = 3002

[[ports]]
localPort = 34969
externalPort = 3003

[[ports]]
localPort = 36879
externalPort = 3001

[[ports]]
localPort = 39317
externalPort = 4200

[[ports]]
localPort = 40387
externalPort = 3000

[[ports]]
localPort = 45531
externalPort = 5173

[[ports]]
localPort = 45893
externalPort = 5000

[deployment]
deploymentTarget = "autoscale"
run = ["php", "-S", "0.0.0.0:5000", "-t", "."]
