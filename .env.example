# Firebase Configuration
# احصل على هذه القيم من Firebase Console
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123

# MySQL Database Configuration
# Format: mysql://username:password@host:port/database
# للنشر على cPanel: استخدم بيانات قاعدة البيانات الخاصة بك
DATABASE_URL=mysql://username:password@localhost:3306/odhiyaty_db

# Application Settings
APP_ENV=development
APP_DEBUG=true

# ملاحظات:
# - في Replit: يمكنك تركها فارغة (سيستخدم SQLite)
# - في cPanel: اضف DATABASE_URL من لوحة التحكم
# - لا تنشر ملف .env على GitHub!
