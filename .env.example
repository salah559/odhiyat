# Firebase Configuration
# احصل على هذه القيم من Firebase Console
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123

# Database Configuration (للنشر على cPanel/Production)
# قم بإلغاء التعليق وتعديل القيم عند النشر
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_NAME=odhiyaty_db
# DB_USER=root
# DB_PASSWORD=your_password_here

# Application Settings
APP_ENV=development
APP_DEBUG=true

# ملاحظات:
# - في Replit: المتغيرات محفوظة في Secrets (آمنة)
# - في cPanel: انسخ هذا الملف إلى .env وأضف القيم الحقيقية
# - لا تنشر ملف .env على GitHub!
